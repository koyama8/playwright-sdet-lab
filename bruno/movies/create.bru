meta {
  name: Create movie with poster URL
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/movies
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Filme de teste",
    "imageUrl": "https://images.example.test/poster.jpg",
    "genre": "Drama",
    "year": 2026,
    "rating": 8.5,
    "favorite": true,
    "synopsis": "Registro criado para validar o fluxo da API."
  }
}
